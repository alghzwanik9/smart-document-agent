# Copy to .env and fill in. Never commit .env.

# One access key for the single user. The backend refuses every request without it, and the frontend sends it.
API_KEY=change-me

# The LLM that reads the payroll sheets. Any OpenAI-compatible chat endpoint works. Payroll sheets are sensitive:
# their text is sent to this provider. Use a local model (Ollama) if they must not leave this machine.
#   Ollama (local):  LLM_BASE_URL=http://host.docker.internal:11434/v1   LLM_MODEL=qwen2.5:7b   LLM_API_KEY=
#   Gemini:          LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.5-flash
#   Groq:            LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-120b
# Nothing is sent until both LLM_BASE_URL and LLM_MODEL are set.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Largest accepted upload in megabytes, and the OCR languages (Tesseract codes).
MAX_UPLOAD_MB=20
OCR_LANGUAGES=ara+eng

# Payroll tables are read by code and the model is asked only which column holds what, once per layout (0 sends every
# sheet whole to the model, which costs many more tokens). Sheets whose column titles are known need no LLM at all.
TABLE_EXTRACTION=1

# Learning from corrections: the most examples shown to the model per chunk of a sheet (0 switches it off), and how close
# (cosine distance, lower is closer) an earlier wrong value must be to a cell of the sheet to count as similar. A wrong
# value written verbatim in the sheet always applies. The default embedding model is downloaded once, about 80 MB.
LEARNING_EXAMPLES=5
LEARNING_MAX_DISTANCE=0.35

# Frontend only: where the backend is. In Docker Compose this is set for you.
API_URL=http://localhost:8000
